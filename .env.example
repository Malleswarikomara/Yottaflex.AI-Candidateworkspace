# Environment Configuration for Application Log Analytics & Monitoring Platform

# Database Connection
# For local SQLite (Default, zero configuration):
DATABASE_URL=sqlite:///./data/logs.db

# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/log_analytics

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data Ingestion Limits
MAX_UPLOAD_SIZE_MB=50
DEFAULT_BATCH_SIZE=10000
